# Configuração da FlexIA. Copie para .env (o configurar.ps1 faz isso) e preencha.
# O .env NUNCA vai para o git (.gitignore). Linhas vazias usam o padrão indicado.

# ---------------------------------------------------------------- credenciais AWS
# Opção A — chaves (conta do Workshop Studio: painel do evento > "Get AWS CLI credentials").
#   Atalho: cole o bloco $Env:AWS_... no PowerShell e rode  .\configurar.ps1 -SalvarCredenciais
#   As chaves do workshop expiram em poucas horas; repita o atalho quando aparecer ExpiredToken.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
# Opção B — perfil do ~/.aws/credentials (deixe as chaves acima vazias). Padrão: hackathon
AWS_PROFILE=

# ---------------------------------------------------------------- AWS
# Região do bucket e dos modelos do Bedrock.
AWS_REGION=us-east-1
# Bucket do data lake. Vazio = ons-datalake-<id da conta>.
FLEXIA_BUCKET=
# Instância do Code Editor do workshop (implantação e agendamento via Systems Manager).
# Vazio = detectada automaticamente pelo configurar.ps1.
CODE_EDITOR_INSTANCIA=

# ---------------------------------------------------------------- dados locais
# Acervo original da equipe (somente leitura).
ORIGEM=C:\Hackathon_ONS
# Clone local do Cavuca (só para empacotar a Lambda em contas que permitem PassRole).
CAVUCA_DIR=

# ---------------------------------------------------------------- chat
# local = agente no mesmo processo; agentcore = runtime implantado (o configurar.ps1 -Implantar preenche o ARN)
FLEXIA_MODO=local
FLEXIA_RUNTIME_ARN=

# ---------------------------------------------------------------- modelos (opcional; padrões testados)
# FLEXIA_MODELO_ROTEADOR=nvidia.nemotron-nano-3-30b
# FLEXIA_MODELO_RAPIDO=nvidia.nemotron-nano-3-30b
# FLEXIA_MODELO_DADOS=us.anthropic.claude-haiku-4-5-20251001-v1:0
# FLEXIA_MODELO_DOCUMENTOS=us.anthropic.claude-haiku-4-5-20251001-v1:0
# FLEXIA_MODELO_RACIOCINIO=us.anthropic.claude-sonnet-4-6

# ---------------------------------------------------------------- WeatherNext (opcional)
# Exige conta Google liberada no formulário do WeatherNext e credenciais do Google Cloud.
# WEATHERNEXT_TABELA=
# WEATHERNEXT_PROJETO=
# WEATHERNEXT_COLUNAS=
